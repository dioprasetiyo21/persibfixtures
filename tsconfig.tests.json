{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx"
  },
  "include": [
    "next-env.d.ts",
    "data/**/*.json",
    "lib/**/*.ts",
    "hooks/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
